# --- Producción (docker compose / Dokploy) ---
# Contraseña de Postgres; el compose construye DATABASE_URL con ella.
POSTGRES_PASSWORD=cambia-esta-contraseña
# Puerto publicado del servicio web en el host (Dokploy suele enrutar por dominio y no lo necesita).
WEB_PORT=3000

# --- Desarrollo local (bun run dev) ---
# Postgres local, por ejemplo `docker compose up -d db` con WEB_PORT/POSTGRES_PASSWORD de arriba:
DATABASE_URL=postgresql://etude:cambia-esta-contraseña@localhost:5432/etude

# --- Inicio de sesión con Google (opcional) ---
# ID de cliente OAuth de tipo «aplicación web» creado en Google Cloud, con la URI
# de redirección `<APP_URL>/api/auth/oauth/google/callback` (en local,
# `http://localhost:3000/api/auth/oauth/google/callback`). Sin estas dos
# variables el botón de Google no se muestra y el resto del login sigue igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de la app: fija la URI de redirección que se manda a Google en vez
# de deducirla de la cabecera Host. Obligatoria en producción; en local sobra.
APP_URL=https://tu-dominio

# --- Reconocimiento de partituras (OMR) ---
# Servicio de `omr-service/`, desplegado aparte (Cloud Run). Sin OMR_URL la
# aplicación no ofrece la opción y todo lo demás funciona igual.
# En local: `cd omr-service && scripts/local_run.sh` levanta el 8000.
OMR_URL=http://localhost:8000
# El mismo token que se le pasó al servicio al desplegarlo; en local puede ir vacío.
OMR_TOKEN=
# Páginas por usuario y hora (20 por defecto).
OMR_PAGES_PER_HOUR=20
