{
  "name": "opus-piano",
  "version": "0.1.0",
  "private": true,
  "description": "Opus Piano — aprende a leer partituras y a tocar el piano. Curso gratuito de lenguaje musical en español.",
  "author": "Axl Santos (FallxnStudio)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "gen:smufl": "node scripts/gen-smufl.mjs",
    "gen:sw": "node scripts/gen-sw.mjs",
    "gen:bbox": "bun scripts/gen-glyph-bbox.mjs",
    "build": "prisma generate && node scripts/gen-smufl.mjs && node scripts/gen-sw.mjs && next build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.test.json",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:covers": "node scripts/gen-catalog-covers.mjs",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "6",
    "arctic": "^3.7.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "prisma": "6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vexflow": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "verovio": "^6.3.0"
  },
  "packageManager": "bun@1.3.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
