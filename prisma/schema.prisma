// Usuarios, sesiones y progreso de práctica. Las partituras siguen solo en el dispositivo (IndexedDB).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cuenta con correo. Contraseña (scrypt) si se registró con ella; con Google
/// puede no tener ninguna. El progreso cuelga del usuario.
model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String?
  createdAt    DateTime           @default(now())
  sessions     Session[]
  accounts     OAuthAccount[]
  exercises    ExerciseProgress[]
  days         DailyActivity[]
  scores       Score[]
  aiCalls      AiCall[]
}

/// Identidad externa (Google) vinculada a un usuario, por el `sub` del proveedor.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Sesión iniciada en un dispositivo. La cookie lleva el token en claro;
/// aquí se guarda solo su hash (SHA-256), como con las contraseñas.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  /// Navegador que la abrió, para listarla en Ajustes.
  userAgent String?

  @@index([userId])
}

model ExerciseProgress {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  attempts   Int       @default(0)
  correct    Int       @default(0)
  bestStreak Int       @default(0)
  lastPlayed DateTime?

  @@unique([userId, exerciseId])
}

/// Actividad por día y ejercicio, para rachas y calendario.
model DailyActivity {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  /// "2026-09-04"
  day        String
  attempts   Int    @default(0)
  correct    Int    @default(0)

  @@unique([userId, exerciseId, day])
  @@index([userId, day])
}

/// Partitura de un usuario. El archivo (PDF o MusicXML) y el MusicXML vinculado
/// viven en disco (SCORES_DIR); aquí solo los metadatos, la miniatura y los trazos.
/// El id lo genera el dispositivo (UUID) para que coincida con su copia local.
model Score {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// "pdf" | "musicxml"
  kind        String
  notes       String   @default("")
  pageCount   Int      @default(0)
  /// data URL de la miniatura (vacía en MusicXML)
  thumbnail   String   @default("")
  annotations Json?
  /// Bytes del archivo principal; 0 hasta que se sube
  size        Int      @default(0)
  uploaded    Boolean  @default(false)
  /// Bytes del MusicXML vinculado (solo PDF), 0 si no hay
  xmlSize     Int      @default(0)
  createdAt   DateTime @default(now())
  /// Última modificación de metadatos, la pone el dispositivo (ms desde época)
  updatedAt   BigInt
  /// Plan de estudio generado con IA (esquema `planStateSchema`); se sincroniza como las notas
  plan        Json?

  @@index([userId, createdAt])
}

/// Cada llamada al modelo que paga el servidor. Cubre dos cosas a la vez: los
/// límites por usuario —que en memoria se perdían en cada despliegue— y el
/// gasto acumulado del mes, que es el que de verdad protege la tarjeta.
/// `userId` se queda en null si la cuenta se borra: el gasto ya se hizo.
model AiCall {
  id     String   @id @default(cuid())
  userId String?
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// "plan" | "ask" | "teacher"
  kind   String
  model  String
  at     DateTime @default(now())

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  /// Coste estimado en millonésimas de dólar: en enteros no hay redondeos raros.
  costMicros       Int @default(0)

  /// "2026-09" del momento de la llamada, para sumar el mes por índice.
  month String

  @@index([userId, kind, at])
  @@index([month])
}
